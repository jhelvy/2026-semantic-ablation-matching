# Copy to .env and fill in. .env is gitignored; never commit real keys.
ANTHROPIC_API_KEY=        # Claude Haiku 5.5 / Sonnet 5.5 (reported runs)
OPENAI_API_KEY=           # GPT-4o-mini bridge (+ v1 OpenAI embeddings)

# Kimi K3, hosted. Default: OpenRouter, pinned to the Moonshot AI provider.
KIMI_API_KEY=             # OpenRouter key (or a Moonshot key if KIMI_BASE_URL points to Moonshot)
# KIMI_BASE_URL=https://api.moonshot.ai/v1   # uncomment to call Moonshot directly
# KIMI_MODEL=kimi-k3                          # model id at Moonshot; OpenRouter default is moonshotai/kimi-k3
# KIMI_RESPONSE_FORMAT=json_schema            # fall back to json_object or none if the host rejects json_schema

# Subscription pilots (llm_*_cli) need no key: they use your `claude` CLI login.
